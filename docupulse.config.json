{
  "projectName": "nextn",
  "rootDir": ".",
  "outputDir": "docs",
  "monorepoSupport": false,
  "ignorePatterns": [
    "node_modules",
    ".git",
    ".svn",
    ".hg",
    "dist",
    "build",
    "out",
    "target",
    "vendor",
    ".venv",
    "venv",
    "env",
    "__pycache__",
    ".next",
    ".nuxt",
    ".svelte-kit",
    ".turbo",
    "coverage",
    ".idea",
    ".vscode",
    ".ds_store",
    "*.min.js",
    "*.bundle.js",
    "*.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "Cargo.lock",
    "poetry.lock",
    "docs",
    ".gemini",
    ".agents"
  ],
  "generator": {
    "generateArchitectureMap": true,
    "generateApiReference": true,
    "generateComponents": true,
    "generateManifest": true,
    "generateIndex": true,
    "badgeStyle": "shields",
    "tocDepth": 3
  },
  "ai": {
    "enabled": false,
    "provider": "gemini",
    "apiKeyEnv": "GEMINI_API_KEY",
    "model": "gemini-1.5-flash",
    "temperature": 0.2
  }
}
